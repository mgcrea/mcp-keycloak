{
  "name": "@mgcrea/mcp-keycloak",
  "version": "0.2.1",
  "description": "Model Context Protocol server for the Keycloak Admin REST API",
  "keywords": [
    "admin",
    "iam",
    "keycloak",
    "mcp",
    "model-context-protocol",
    "oidc"
  ],
  "license": "MIT",
  "author": "Olivier Louvignes <olivier@mgcrea.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgcrea/mcp-keycloak.git"
  },
  "bin": {
    "keycloak-mcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/cli.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docker:build": "BUILDER=build scripts/docker-build.sh",
    "docker:buildx": "BUILDER=buildx scripts/docker-build.sh",
    "docker:push": "docker push mgcrea/mcp-keycloak:latest && docker push mgcrea/mcp-keycloak:$npm_package_version",
    "docker:release": "BUILDER=buildx scripts/docker-build.sh --push",
    "prepublishOnly": "pnpm build",
    "release": "pnpm dlx release-it"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsdown": "^0.23.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1"
}
